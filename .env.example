# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB — leave blank to use in-memory fallback (local dev only)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/resumeflow

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI (Groq)
GROQ_API_KEY=gsk_...

# Redis (used by Socket.io adapter and OTP storage)
# In Docker: redis://redis:6379
# Local dev without Docker: leave blank (falls back to in-memory)
REDIS_URL=

# SMTP for OTP emails (Gmail example)
# Get App Password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password

# Client URL (for CORS)
# Docker: http://localhost
# Local dev: http://localhost:5173
CLIENT_URL=http://localhost

# ─── Client (Vite) ────────────────────────────────────────────────────────────
# If running behind a reverse proxy, leave blank (uses same origin)
# For local dev pointing to separate backend:
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
